#!/usr/bin/env zsh

VM_DIR="${VM_DIR:-$HOME/VMs}"

get_vm_display_name() {
    local dir="$1"
    local vm_id="$(basename "$dir")"
    if [[ -f "$dir/vm-curator.toml" ]]; then
        local dn
        dn=$(sed -n 's/^display_name *= *["\x27]\(.*\)["\x27]/\1/p' "$dir/vm-curator.toml" 2>/dev/null)
        if [[ -n "$dn" ]]; then
            echo "$dn"
            return
        fi
    fi
    echo "$vm_id"
}

is_vm_running() {
    local vm_id="$1"
    pgrep -f "qemu.*$vm_id" &>/dev/null
}

list_vms_json() {
    local first=1
    local vm_id=""
    local display_name=""
    local running=false
    local safe_id=""
    local safe_name=""
    printf "["
    for d in "$VM_DIR"/*(/N); do
        vm_id="$(basename "$d")"
        if [[ -f "$d/launch.sh" || -f "$d/vm-curator.toml" ]]; then
            display_name=$(get_vm_display_name "$d")
            running=false
            if is_vm_running "$vm_id"; then
                running=true
            fi
            if (( ! first )); then
                printf ","
            fi
            first=0
            safe_id="${vm_id//\"/\\\"}"
            safe_name="${display_name//\"/\\\"}"
            printf '{"id":"%s","name":"%s","running":%s}' "$safe_id" "$safe_name" "$running"
        fi
    done
    printf "]\n"
}

list_vms() {
    local vm_id=""
    local display_name=""
    local vm_status=""
    for d in "$VM_DIR"/*(/N); do
        vm_id="$(basename "$d")"
        if [[ -f "$d/launch.sh" || -f "$d/vm-curator.toml" ]]; then
            display_name=$(get_vm_display_name "$d")
            vm_status=""
            if is_vm_running "$vm_id"; then
                vm_status=" (running)"
            fi
            if [[ "$display_name" != "$vm_id" ]]; then
                echo "$vm_id - $display_name$vm_status"
            else
                echo "$vm_id$vm_status"
            fi
        fi
    done
}

start_vm() {
    local target="$1"
    if [[ -z "$target" ]]; then
        echo "Usage: cmd-vm start <vm_name_or_id>" >&2
        return 1
    fi

    local vm_path=""
    local vm_id=""

    # 1. Direct directory match
    if [[ -d "$VM_DIR/$target" ]]; then
        vm_path="$VM_DIR/$target"
        vm_id="$target"
    else
        # 2. Match by display name
        for d in "$VM_DIR"/*(/N); do
            local dn
            dn=$(get_vm_display_name "$d")
            if [[ "${(L)dn}" == "${(L)target}" ]]; then
                vm_path="$d"
                vm_id="$(basename "$d")"
                break
            fi
        done
    fi

    if [[ -z "$vm_path" || ! -d "$vm_path" ]]; then
        notify-send -a "Virtual Machines" -u critical "VM Error" "VM '$target' not found in $VM_DIR"
        return 1
    fi

    local display_name
    display_name=$(get_vm_display_name "$vm_path")

    # If VM is already running, focus its window in Hyprland
    if is_vm_running "$vm_id"; then
        local win_addr
        win_addr=$(hyprctl clients -j 2>/dev/null | jq -r '.[]|select((.class|test("qemu"; "i")) or (.title|test("QEMU"; "i")))|.address' | head -n1)
        if [[ -n "$win_addr" && "$win_addr" != "null" ]]; then
            hyprctl dispatch "hl.dsp.focus({ window = \"address:$win_addr\" })" >/dev/null 2>&1
            notify-send -a "Virtual Machines" -i "computer" "Virtual Machine" "'$display_name' is already running — focused window."
        else
            notify-send -a "Virtual Machines" -i "computer" "Virtual Machine" "'$display_name' is already running."
        fi
        return 0
    fi

    # Launch standalone script generated by VM Curator
    if [[ -x "$vm_path/launch.sh" || -f "$vm_path/launch.sh" ]]; then
        chmod +x "$vm_path/launch.sh"
        notify-send -a "Virtual Machines" -i "computer" "Virtual Machine" "Launching '$display_name'..."
        setsid "$vm_path/launch.sh" >/dev/null 2>&1 &!
        return 0
    fi

    # Fallback: vm-curator CLI launch
    if command -v vm-curator &>/dev/null; then
        notify-send -a "Virtual Machines" -i "computer" "Virtual Machine" "Launching '$display_name' via vm-curator..."
        setsid vm-curator launch "$vm_id" >/dev/null 2>&1 &!
        return 0
    fi

    notify-send -a "Virtual Machines" -u critical "VM Error" "No launch.sh found for '$display_name' in $VM_DIR"
    return 1
}

case "$1" in
    list)
        if [[ "$2" == "--json" ]]; then
            list_vms_json
        else
            list_vms
        fi
        ;;
    list-json)
        list_vms_json
        ;;
    start)
        start_vm "$2"
        ;;
    *)
        echo "Usage: cmd-vm {list [--json]|list-json|start <vm>}"
        exit 1
        ;;
esac
