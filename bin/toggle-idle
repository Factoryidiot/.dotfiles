#!/usr/bin/env zsh

if systemctl --user is-active hypridle.service &>/dev/null; then
  systemctl --user stop hypridle.service
  notify-send -u normal -i preferences-desktop-screensaver "Idle Lock" "Stopped locking computer when idle"
elif pgrep -x hypridle >/dev/null; then
  pkill -x hypridle
  notify-send -u normal -i preferences-desktop-screensaver "Idle Lock" "Stopped locking computer when idle"
else
  systemctl --user start hypridle.service 2>/dev/null || uwsm-app -- hypridle >/dev/null 2>&1 &
  notify-send -u normal -i preferences-desktop-screensaver "Idle Lock" "Now locking computer when idle"
fi
